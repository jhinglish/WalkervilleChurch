{
  "name": "walkerville-roster",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Sunday ministry roster for Walkerville Church Plant, published as a claude.ai artifact.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "verify": "npm run check && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
